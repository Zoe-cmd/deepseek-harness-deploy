[Unit]
Description=DeepSeek Harness web server (loopback only)
After=network.target

[Service]
Type=simple
# Adjust to your checkout location.
WorkingDirectory=/root/app/deepseek
ExecStart=/usr/bin/env node /root/app/deepseek/node_modules/@deepseek-ai/dsh/lib/bin.js web
Restart=on-failure
RestartSec=3

# Isolate: no public network listeners.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target