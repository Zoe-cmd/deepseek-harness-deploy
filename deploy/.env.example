# =============================================================
# DeepSeek Harness — 前置 Token 认证网关配置
# 复制为 .env 并填写真实值。.env 已被 .gitignore 忽略，禁止提交。
# =============================================================

# 必须：允许访问 Harness 的 Access Token（管理员分配，请保持私密）。
# 推荐：openssl rand -hex 32
HARNESS_ACCESS_TOKEN=

# 会话签名密钥。推荐：openssl rand -hex 32
# 未设置时网关启动会生成临时密钥，进程重启后所有会话失效。
SESSION_SECRET=

# 会话有效期（秒）。默认 86400 = 24 小时
SESSION_EXPIRE_SECONDS=86400

# 会话最大总寿命（秒）。默认 604800 = 7 天，即使滑动续期也封顶
SESSION_MAX_LIFETIME_SECONDS=604800

# 滑动续期：每次请求刷新到期时间（1=开 0=关）。默认 1
SESSION_SLIDING=1

# 将会话绑定到登录时的客户端 IP（1=开 0=关）。默认 0
# IP 发生变化会被强制登出，适合固定 IP/VPN 场景
SESSION_BIND_IP=0

# 认证网关监听地址 —— 必须保持回环地址，禁止 0.0.0.0
AUTH_HOST=127.0.0.1
AUTH_PORT=3081

# Harness 上游地址 —— 必须保持回环地址，禁止 0.0.0.0
HARNESS_HOST=127.0.0.1
HARNESS_PORT=3080

# 会话 Cookie 加 Secure 标记（HTTPS 下必须 1；仅纯 HTTP 调试时设 0）
COOKIE_SECURE=1

# 登录防暴力破解
RATE_LIMIT_MAX=10            # 窗口内最大失败次数
RATE_LIMIT_WINDOW_MS=900000  # 窗口长度（毫秒）= 15 分钟
RATE_LIMIT_BAN_MS=900000     # 超过后的封禁时长（毫秒）

# 信任 nginx 传入的 X-Forwarded-For 作为客户端 IP（网关仅监听回环，安全）
TRUST_PROXY=1

# 会话 Cookie 名称
SESSION_COOKIE_NAME=dsh_session