[Unit]
Description=DSH auth gateway (session cookie + rate limit + reverse proxy)
After=network.target
Wants=dsh-harness.service

[Service]
Type=simple
WorkingDirectory=/root/test/test
EnvironmentFile=/root/test/test/deploy/.env
ExecStart=/usr/bin/env node /root/test/test/deploy/auth-gateway/server.mjs
Restart=on-failure
RestartSec=3

PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target